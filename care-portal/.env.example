# 既存の整体院アプリと同じ Supabase プロジェクトでも、別プロジェクトでも可
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 会員向け画面・印刷案内に表示する問い合わせ先（任意）
# 例: VITE_CLINIC_HELP_PHONE=あつ整体院 高槻院 072-XXX-XXXX
VITE_CLINIC_HELP_PHONE=

# Edge Function のベースURL（通常は VITE_SUPABASE_URL と同じ）
# 動画再生用の署名付きURL取得に使用
VITE_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1
